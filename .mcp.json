{
  "mcpServers": {
    "coursetools": {
      "command": "python3",
      "args": [
        "/workspace/mcp/coursetools_server.py"
      ],
      "env": {
        "COURSETOOLS_ROOT": "/workspace",
        "COURSETOOLS_ALLOWLIST": "/workspace/mcp/roles.allowlist.json"
      }
    },
    "storage": {
      "type": "http",
      "url": "http://localhost:8001/mcp"
    },
    "retrieval": {
      "type": "http",
      "url": "http://localhost:8002/mcp"
    }
  }
}